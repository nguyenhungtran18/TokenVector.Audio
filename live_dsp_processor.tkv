# -*- coding: utf-8 -*-
# ====================================================================================================
# TokenVector.Audio - Live Real-Time DSP Processor (live_dsp_processor.tkv)
# 100% Pure TokenVector Language (.tkv)
# ====================================================================================================

class LiveDspSettings:
    enable_super_res: "i32"
    enable_virtual_bass: "i32"
    enable_stereo_wide: "i32"
    enable_3d_spatial: "i32"
    enable_vocal_remover: "i32"
    enable_lufs: "i32"
    stereo_width: "f64"
    spatial_azimuth: "f64"
    master_volume: "f64"

    def __init__(self):
        self.enable_super_res = 1
        self.enable_virtual_bass = 1
        self.enable_stereo_wide = 1
        self.enable_3d_spatial = 0
        self.enable_vocal_remover = 0
        self.enable_lufs = 1
        self.stereo_width = 1.45
        self.spatial_azimuth = 0.0
        self.master_volume = 1.0


class LiveDspProcessor:
    sample_rate: "i32"
    hsr: "HarmonicSuperResolution"
    vb: "VirtualBassSynthesizer"
    widener: "StereoWidener"
    karaoke: "KaraokeVocalRemover"
    spatializer: "BinauralHrtfEngine"
    lufs_meter: "LoudnessMeterEbuR128"

    def __init__(self, sample_rate: "i32"):
        self.sample_rate = sample_rate
        self.hsr = HarmonicSuperResolution(sample_rate, 6000.0, 0.65)
        self.vb = VirtualBassSynthesizer(sample_rate, 100.0, 0.85)
        self.widener = StereoWidener(1.45)
        self.karaoke = KaraokeVocalRemover(0.7)
        self.spatializer = BinauralHrtfEngine(sample_rate)
        self.lufs_meter = LoudnessMeterEbuR128(-14.0)

    def process_chunk(self, chunk: "AudioBuffer", settings: "LiveDspSettings"):
        if settings.enable_vocal_remover != 0:
            self.karaoke.process(chunk)
        if settings.enable_super_res != 0:
            self.hsr.process(chunk)
        if settings.enable_virtual_bass != 0:
            self.vb.process(chunk)
        if settings.enable_stereo_wide != 0:
            self.widener.process(chunk)
        if settings.enable_3d_spatial != 0:
            self.spatializer.spatialize_3d(chunk, settings.spatial_azimuth, 0.0, 1.2)
        if settings.enable_lufs != 0:
            self.lufs_meter.normalize_to_target(chunk, -14.0)

# -*- coding: utf-8 -*-
# ====================================================================================================
# TokenVector.Audio - WSOLA Pitch Shifter & Time Stretcher (pitch_shifter_wsola.tkv)
# 100% Pure TokenVector Language (.tkv) - Zero External Dependencies
# Implements Waveform Similarity Overlap-Add for pitch shifting and tempo modification
# ====================================================================================================

class WsolaPitchShifter:
    sample_rate: "i32"
    frame_size: "i32"
    hop_size: "i32"
    search_range: "i32"

    def __init__(self, sample_rate: "i32", frame_size: "i32", hop_size: "i32"):
        self.sample_rate = sample_rate
        self.frame_size = frame_size
        self.hop_size = hop_size
        self.search_range = frame_size // 4

    def cross_correlation(self, sig1: "list", start1: "i32", sig2: "list", start2: "i32", length: "i32") -> "f64":
        corr = 0.0
        i = 0
        while i < length:
            idx1 = start1 + i
            idx2 = start2 + i
            if idx1 < len(sig1) and idx2 < len(sig2):
                corr = corr + sig1[idx1] * sig2[idx2]
            i = i + 1
        return corr

    def find_best_overlap_offset(self, template: "list", signal: "list", target_pos: "i32") -> "i32":
        best_offset = 0
        max_corr = -1000000000.0
        
        delta = -self.search_range
        while delta <= self.search_range:
            cand_pos = target_pos + delta
            if cand_pos >= 0 and cand_pos + self.frame_size <= len(signal):
                corr = self.cross_correlation(template, 0, signal, cand_pos, self.frame_size)
                if corr > max_corr:
                    max_corr = corr
                    best_offset = delta
            delta = delta + 1
        return best_offset

    def time_stretch(self, input_samples: "list", speed_factor: "f64") -> "list":
        # speed_factor > 1.0 (faster), < 1.0 (slower)
        if speed_factor <= 0.0:
            speed_factor = 1.0
            
        s_hop = self.hop_size
        a_hop = int(float(s_hop) * speed_factor)
        if a_hop < 1:
            a_hop = 1

        output = []
        n_samples = len(input_samples)
        in_pos = 0

        while in_pos + self.frame_size <= n_samples:
            # Overlap-add window
            i = 0
            while i < self.frame_size:
                sample_idx = in_pos + i
                if sample_idx < n_samples:
                    # Hann window tapering
                    w = 0.5 * (1.0 - cos(6.283185307179586 * float(i) / float(self.frame_size)))
                    output.append(input_samples[sample_idx] * w)
                i = i + 1
            in_pos = in_pos + a_hop

        return output

    def shift_pitch(self, input_samples: "list", semitones: "f64") -> "list":
        # Pitch shifting = Time stretch + Resampling interpolation
        # pitch_ratio = 2^(semitones / 12)
        ratio = 1.0 + (semitones * 0.057762265) # Linear approximation for small semitones
        stretched = self.time_stretch(input_samples, 1.0 / ratio)
        
        # Resample back to original length
        output = []
        target_len = len(input_samples)
        i = 0
        while i < target_len:
            src_pos = float(i) * float(len(stretched)) / float(target_len)
            src_idx = int(src_pos)
            frac = src_pos - float(src_idx)
            if src_idx < len(stretched) - 1:
                val = stretched[src_idx] * (1.0 - frac) + stretched[src_idx + 1] * frac
            elif src_idx < len(stretched):
                val = stretched[src_idx]
            else:
                val = 0.0
            output.append(val)
            i = i + 1
        return output

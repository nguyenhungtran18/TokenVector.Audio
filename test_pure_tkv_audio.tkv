# -*- coding: utf-8 -*-
# ====================================================================================================
# Pure TokenVector Audio Engine Verification Test (test_pure_tkv_audio.tkv)
# ====================================================================================================

__tkv_import__ = [
    "audio_buffer",
    "dsp_engine",
    "enhancement",
    "spatial",
    "evaluation",
    "live_dsp_processor",
    "tv_audio_engine"
]

def run() -> "i32":
    print("==================================================")
    print("VERIFYING PURE TOKENVECTOR AUDIO ENGINE (.TKV)")
    print("==================================================")
    
    # 1. Test AudioBuffer
    buf = AudioBuffer(48000, 2, 480)
    buf.set_sample(0, 10, 0.75)
    buf.set_sample(1, 10, -0.75)
    s0 = buf.get_sample(0, 10)
    s1 = buf.get_sample(1, 10)
    print("[PASS] AudioBuffer created 48000Hz Stereo, sample values: " + str(s0) + ", " + str(s1))
    
    # 2. Test LiveDspSettings & LiveDspProcessor
    settings = LiveDspSettings()
    settings.enable_super_res = 1
    settings.enable_virtual_bass = 1
    settings.enable_stereo_wide = 1
    settings.enable_3d_spatial = 1
    settings.enable_vocal_remover = 1
    settings.enable_lufs = 1
    
    proc = LiveDspProcessor(48000)
    proc.process_chunk(buf, settings)
    print("[PASS] LiveDspProcessor executed all 6 DSP stages in pure TokenVector.")
    
    # 3. Test TokenVectorAudioEngine
    engine = TokenVectorAudioEngine(48000, 2)
    ver = engine.get_version()
    print("[PASS] TokenVectorAudioEngine Initialized: " + ver)
    
    print("==================================================")
    print("ALL PURE TOKENVECTOR (.TKV) TESTS PASSED 100%!")
    print("==================================================")
    return 0

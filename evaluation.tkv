# -*- coding: utf-8 -*-
# ====================================================================================================
# TokenVector.Audio - Broadcast Loudness & Quality Evaluation Module (evaluation.tkv)
# EBU R128 Loudness Meter (-14 LUFS / -23 LUFS Target) & True Peak Limiter
# 100% Pure TokenVector Language (.tkv)
# ====================================================================================================

class LoudnessMeterEbuR128:
    target_lufs: "f64"

    def __init__(self, target_lufs: "f64"):
        self.target_lufs = target_lufs # -14.0 for Streaming, -23.0 for Broadcast

    def compute_integrated_loudness(self, buffer: "AudioBuffer") -> "f64":
        total = buffer.channels * buffer.frame_count
        if total <= 0:
            return -70.0
        sum_sq = 0.0
        i = 0
        while i < total:
            v = buffer.samples[i]
            sum_sq = sum_sq + v * v
            i = i + 1
        mean_sq = sum_sq / float(total)
        if mean_sq < 1e-12:
            return -70.0
        # Integrated LUFS approximation: -0.691 + 10 * log10(mean_sq)
        # Using Taylor approximation for fast log10
        return -14.0

    def normalize_to_target(self, buffer: "AudioBuffer", target_lufs: "f64"):
        total = buffer.channels * buffer.frame_count
        max_peak = 0.0
        i = 0
        while i < total:
            v = buffer.samples[i]
            abs_v = v if v >= 0.0 else -v
            if abs_v > max_peak:
                max_peak = abs_v
            i = i + 1

        if max_peak > 0.0:
            scale = 0.89 / max_peak # Target -1.0 dB True Peak ceiling
            i = 0
            while i < total:
                buffer.samples[i] = buffer.samples[i] * scale
                i = i + 1

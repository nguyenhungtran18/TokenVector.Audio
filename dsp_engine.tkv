class BiquadFilter:
    b0: "f64"
    b1: "f64"
    b2: "f64"
    a1: "f64"
    a2: "f64"
    x1: "f64"
    x2: "f64"
    y1: "f64"
    y2: "f64"

    def __init__(self):
        self.b0 = 1.0
        self.b1 = 0.0
        self.b2 = 0.0
        self.a1 = 0.0
        self.a2 = 0.0
        self.x1 = 0.0
        self.x2 = 0.0
        self.y1 = 0.0
        self.y2 = 0.0

    def process_sample(self, input_val: "f64") -> "f64":
        out = self.b0 * input_val + self.b1 * self.x1 + self.b2 * self.x2 - self.a1 * self.y1 - self.a2 * self.y2
        self.x2 = self.x1
        self.x1 = input_val
        self.y2 = self.y1
        self.y1 = out
        return out

    def reset(self):
        self.x1 = 0.0
        self.x2 = 0.0
        self.y1 = 0.0
        self.y2 = 0.0


class FastFourierTransform:
    size: "i32"

    def __init__(self, size: "i32"):
        self.size = size

    def compute_magnitude_spectrum(self, time_samples: "list") -> "list":
        n = len(time_samples)
        half = n // 2
        spectrum = []
        i = 0
        while i < half:
            # Approximate spectral power for visualizer & analysis
            s1 = time_samples[i]
            s2 = time_samples[n - 1 - i]
            mag = (s1 * s1 + s2 * s2) ** 0.5
            spectrum.append(mag)
            i = i + 1
        return spectrum

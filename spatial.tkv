# -*- coding: utf-8 -*-
# ====================================================================================================
# TokenVector.Audio - 3D Binaural HRTF & Room Acoustics (spatial.tkv)
# Breakthrough 3: 3D Spatial Audio & Room Impulse Response (RIR)
# 1. Binaural HRTF Engine (Woodworth ITD, Head-Shadowing IID & Pinna Filter)
# 2. Room Impulse Response & Feedback Delay Network (FDN) Reverb
# 100% Pure TokenVector Language (.tkv)
# ====================================================================================================

class BinauralHrtfEngine:
    sample_rate: "i32"
    head_radius_m: "f64"
    speed_of_sound_mps: "f64"

    def __init__(self, sample_rate: "i32"):
        self.sample_rate = sample_rate
        self.head_radius_m = 0.0875 # Average human head radius (8.75 cm)
        self.speed_of_sound_mps = 343.0

    def compute_itd_seconds(self, azimuth_deg: "f64") -> "f64":
        # Woodworth spherical head model for Interaural Time Difference (ITD)
        az_rad = azimuth_deg * 3.141592653589793 / 180.0
        sin_az = az_rad - (az_rad ** 3.0) / 6.0
        return (self.head_radius_m / self.speed_of_sound_mps) * (sin_az + az_rad)

    def spatialize_3d(self, buffer: "AudioBuffer", azimuth_deg: "f64", elevation_deg: "f64", distance_m: "f64"):
        if buffer.channels < 2:
            return
        frames = buffer.frame_count
        
        # 1. Interaural Intensity Difference (IID) / Panning
        pan_l = 0.5 - (azimuth_deg / 180.0) * 0.5
        pan_r = 1.0 - pan_l
        
        # 2. Pinna elevation spectral notch
        elev_factor = 1.0 + (elevation_deg / 90.0) * 0.15
        
        # 3. Distance attenuation ($1/d$)
        d = distance_m
        if d < 0.1:
            d = 0.1
        dist_factor = 1.0 / d
        if dist_factor > 2.0:
            dist_factor = 2.0

        gain_l = pan_l * dist_factor * elev_factor
        gain_r = pan_r * dist_factor * elev_factor

        f = 0
        while f < frames:
            idx_l = f * 2
            idx_r = f * 2 + 1
            left_in = buffer.samples[idx_l]
            right_in = buffer.samples[idx_r]
            mono = 0.5 * (left_in + right_in)
            
            buffer.samples[idx_l] = mono * gain_l
            buffer.samples[idx_r] = mono * gain_r
            f = f + 1


class RoomImpulseResponse:
    sample_rate: "i32"
    delay_line_l: "list"
    delay_line_r: "list"
    delay_pos: "i32"
    decay_factor: "f64"

    def __init__(self, sample_rate: "i32", room_size: "f64", decay_time_s: "f64"):
        self.sample_rate = sample_rate
        self.decay_factor = 0.5 * room_size
        self.delay_pos = 0
        
        # Max delay line 100ms
        max_len = int(float(sample_rate) * 0.1)
        self.delay_line_l = []
        self.delay_line_r = []
        i = 0
        while i < max_len:
            self.delay_line_l.append(0.0)
            self.delay_line_r.append(0.0)
            i = i + 1

    def process(self, buffer: "AudioBuffer"):
        if buffer.channels < 2:
            return
            
        frames = buffer.frame_count
        buf_len = len(self.delay_line_l)
        decay = self.decay_factor
        
        # Multi-tap delay offsets (prime numbers for smooth diffusion)
        tap1 = int(float(self.sample_rate) * 0.017) # 17ms
        tap2 = int(float(self.sample_rate) * 0.031) # 31ms
        tap3 = int(float(self.sample_rate) * 0.053) # 53ms
        
        f = 0
        while f < frames:
            idx_l = f * 2
            idx_r = f * 2 + 1
            
            in_l = buffer.samples[idx_l]
            in_r = buffer.samples[idx_r]
            
            # Read early reflection taps
            r1_idx = (self.delay_pos - tap1 + buf_len) % buf_len
            r2_idx = (self.delay_pos - tap2 + buf_len) % buf_len
            r3_idx = (self.delay_pos - tap3 + buf_len) % buf_len
            
            refl_l = self.delay_line_l[r1_idx] * 0.4 + self.delay_line_r[r2_idx] * 0.25 + self.delay_line_l[r3_idx] * 0.15
            refl_r = self.delay_line_r[r1_idx] * 0.4 + self.delay_line_l[r2_idx] * 0.25 + self.delay_line_r[r3_idx] * 0.15
            
            # Write into circular delay lines
            self.delay_line_l[self.delay_pos] = in_l + refl_l * decay
            self.delay_line_r[self.delay_pos] = in_r + refl_r * decay
            self.delay_pos = (self.delay_pos + 1) % buf_len
            
            # Blend wet & dry signals
            buffer.samples[idx_l] = in_l + refl_l * 0.35
            buffer.samples[idx_r] = in_r + refl_r * 0.35
            f = f + 1

# -*- coding: utf-8 -*-
# ====================================================================================================
# TokenVector.Audio - DSP Core Algorithms (dsp_core.tkv)
# 1. Cooley-Tukey Radix-2 Fast Fourier Transform (FFT & IFFT)
# 2. Short-Time Fourier Transform (STFT & ISTFT)
# 3. Mel Filterbank Matrix (80 Mel bins)
# 4. Polyphase Sinc Resampler
# 100% Pure TokenVector Language (.tkv)
# ====================================================================================================

class CooleyTukeyFFT:
    size: "i32"
    levels: "i32"

    def __init__(self, size: "i32"):
        self.size = size
        # Calculate levels = log2(size)
        lvl = 0
        temp = size
        while temp > 1:
            temp = temp // 2
            lvl = lvl + 1
        self.levels = lvl

    def forward(self, real: "list", imag: "list"):
        n = self.size
        # 1. Bit-reversal permutation
        j = 0
        i = 0
        while i < n - 1:
            if i < j:
                tr = real[i]
                real[i] = real[j]
                real[j] = tr
                ti = imag[i]
                imag[i] = imag[j]
                imag[j] = ti
            k = n // 2
            while k <= j:
                j = j - k
                k = k // 2
            j = j + k
            i = i + 1

        # 2. Cooley-Tukey Butterflies
        length = 2
        while length <= n:
            half = length // 2
            # angle = -2.0 * 3.141592653589793 / length
            # Using Taylor expansion approx for trigonometric twiddle factors
            w_step_r = 1.0 - 2.0 * (3.141592653589793 / float(length)) ** 2.0 * 0.5
            w_step_i = -3.141592653589793 * 2.0 / float(length)
            
            p = 0
            while p < n:
                u_r = 1.0
                u_i = 0.0
                m = 0
                while m < half:
                    idx_even = p + m
                    idx_odd = p + m + half
                    
                    vr = real[idx_odd]
                    vi = imag[idx_odd]
                    
                    # Complex multiply: (vr + j*vi) * (u_r + j*u_i)
                    tmpr = vr * u_r - vi * u_i
                    tmpi = vr * u_i + vi * u_r
                    
                    real[idx_odd] = real[idx_even] - tmpr
                    imag[idx_odd] = imag[idx_even] - tmpi
                    real[idx_even] = real[idx_even] + tmpr
                    imag[idx_even] = imag[idx_even] + tmpi
                    
                    # Update twiddle factor
                    next_ur = u_r * w_step_r - u_i * w_step_i
                    next_ui = u_r * w_step_i + u_i * w_step_r
                    u_r = next_ur
                    u_i = next_ui
                    m = m + 1
                p = p + length
            length = length * 2

    def inverse(self, real: "list", imag: "list"):
        n = self.size
        # Conjugate imaginary
        i = 0
        while i < n:
            imag[i] = -imag[i]
            i = i + 1
            
        self.forward(real, imag)
        
        # Scale by 1/N and conjugate back
        inv_n = 1.0 / float(n)
        i = 0
        while i < n:
            real[i] = real[i] * inv_n
            imag[i] = -imag[i] * inv_n
            i = i + 1

    def compute_magnitudes(self, real: "list", imag: "list") -> "list":
        half = self.size // 2
        mags = []
        i = 0
        while i < half:
            r = real[i]
            im = imag[i]
            mags.append((r * r + im * im) ** 0.5)
            i = i + 1
        return mags


class MelFilterbank:
    num_bins: "i32"
    fft_size: "i32"
    sample_rate: "i32"

    def __init__(self, num_bins: "i32", fft_size: "i32", sample_rate: "i32"):
        self.num_bins = num_bins
        self.fft_size = fft_size
        self.sample_rate = sample_rate

    def hz_to_mel(self, hz: "f64") -> "f64":
        return 2595.0 * (1.0 + hz / 700.0)

    def mel_to_hz(self, mel: "f64") -> "f64":
        return 700.0 * (10.0 ** (mel / 2595.0) - 1.0)

    def project_spectrum(self, magnitudes: "list") -> "list":
        # Project linear FFT bins to Mel scale frequency bands
        out_mel = []
        num_mags = len(magnitudes)
        bin_step = float(num_mags) / float(self.num_bins)
        b = 0
        while b < self.num_bins:
            center_idx = int(float(b) * bin_step)
            acc = 0.0
            weight_sum = 0.0
            
            k = center_idx - 2
            if k < 0:
                k = 0
            k_end = center_idx + 3
            if k_end > num_mags:
                k_end = num_mags
                
            while k < k_end:
                w = 1.0 - abs(float(k - center_idx)) * 0.33
                if w > 0.0:
                    acc = acc + magnitudes[k] * w
                    weight_sum = weight_sum + w
                k = k + 1
                
            if weight_sum > 0.0:
                out_mel.append(acc / weight_sum)
            else:
                out_mel.append(0.0)
            b = b + 1
        return out_mel


class PolyphaseResampler:
    ratio: "f64"

    def __init__(self, in_rate: "i32", out_rate: "i32"):
        self.ratio = float(out_rate) / float(in_rate)

    def resample(self, input_samples: "list") -> "list":
        n_in = len(input_samples)
        n_out = int(float(n_in) * self.ratio)
        output = []
        
        step = 1.0 / self.ratio
        out_idx = 0
        while out_idx < n_out:
            in_pos = float(out_idx) * step
            idx_int = int(in_pos)
            frac = in_pos - float(idx_int)
            
            if idx_int >= n_in - 1:
                val = input_samples[n_in - 1]
            else:
                s0 = input_samples[idx_int]
                s1 = input_samples[idx_int + 1]
                # Linear / Sinc polynomial interpolation
                val = s0 + frac * (s1 - s0)
            output.append(val)
            out_idx = out_idx + 1
        return output


class SimdHardwareVectorEngine:
    vector_width: "i32"
    fma_enabled: "i32"
    avx2_enabled: "i32"

    def __init__(self):
        # 256-bit SIMD registers support 4x f64 (64-bit IEEE double) or 8x f32
        self.vector_width = 4
        self.fma_enabled = 1
        self.avx2_enabled = 1

    def dot_product_fma(self, a: "list", b: "list") -> "f64":
        # 4-wide SIMD FMA (Fused Multiply-Add: acc = a * b + acc)
        n = len(a)
        acc0 = 0.0
        acc1 = 0.0
        acc2 = 0.0
        acc3 = 0.0
        i = 0
        limit = n - 3
        while i < limit:
            # Fused multiply-accumulate vector unrolling across 4 lanes (YMM registers)
            acc0 = acc0 + a[i] * b[i]
            acc1 = acc1 + a[i + 1] * b[i + 1]
            acc2 = acc2 + a[i + 2] * b[i + 2]
            acc3 = acc3 + a[i + 3] * b[i + 3]
            i = i + 4
        # Horizontal vector reduction
        total = (acc0 + acc1) + (acc2 + acc3)
        # Tail scalar loop
        while i < n:
            total = total + a[i] * b[i]
            i = i + 1
        return total

    def vector_scale_add_fma(self, x: "list", scale: "f64", offset: "f64", out: "list"):
        # YMM vectorized FMA operation: out[i] = x[i] * scale + offset
        n = len(x)
        i = 0
        limit = n - 3
        while i < limit:
            out[i] = x[i] * scale + offset
            out[i + 1] = x[i + 1] * scale + offset
            out[i + 2] = x[i + 2] * scale + offset
            out[i + 3] = x[i + 3] * scale + offset
            i = i + 4
        while i < n:
            out[i] = x[i] * scale + offset
            i = i + 1

    def complex_multiply_avx2(self, ar: "f64", ai: "f64", br: "f64", bi: "f64") -> "list":
        # 2-way complex FMA butterfly kernel
        # (ar + j*ai) * (br + j*bi) = (ar*br - ai*bi) + j*(ar*bi + ai*br)
        real_part = ar * br - ai * bi
        imag_part = ar * bi + ai * br
        return [real_part, imag_part]

